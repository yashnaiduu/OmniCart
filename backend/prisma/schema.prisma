// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String       @id @default(uuid()) @map("user_id")
  email              String       @unique
  passwordHash       String       @map("password_hash")
  latitude           Float?
  longitude          Float?
  city               String?
  accuracy           Float?
  lastLocationUpdate DateTime?    @map("last_location_update")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  Preference    Preference?
  Collections   Collection[]
  Orders        Order[]
  Sessions      UserSession[]
  SearchHistory SearchHistory[]
  PriceAlerts   PriceAlert[]

  @@index([latitude, longitude])
  @@index([email])
  @@map("users")
}

model Preference {
  id                   String   @id @map("user_id")
  brandPreferences     Json?    @map("brand_preferences")
  budgetLimit          Int?     @map("budget_limit")
  preferredPlatforms   String[] @map("preferred_platforms") // Changed to native String array
  notificationSettings Json?    @map("notification_settings")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Collection {
  id          String   @id @default(uuid()) @map("collection_id")
  userId      String   @map("user_id")
  name        String
  description String?
  type        String?
  frequency   String?
  isShared    Boolean  @default(false) @map("is_shared")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
  @@map("collections")
}

model CollectionItem {
  id             String  @id @default(uuid()) @map("item_id")
  collectionId   String  @map("collection_id")
  name           String?
  quantity       String?
  normalizedName String? @map("normalized_name")
  category       String?
  priority       Int?    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([normalizedName])
  @@map("collection_items")
}

model Order {
  id            String   @id @default(uuid()) @map("order_id")
  userId        String?  @map("user_id")
  platform      String?
  totalCost     Int?     @map("total_cost")
  platformSplit Json?    @map("platform_split")
  items         Json?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("orders")
}

model SearchHistory {
  id        String   @id @default(uuid()) @map("search_id")
  userId    String?  @map("user_id")
  query     String
  latitude  Float?
  longitude Float?
  city      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([query])
  @@map("search_history")
}

model PriceAlert {
  id             String   @id @default(uuid()) @map("alert_id")
  userId         String   @map("user_id")
  normalizedName String   @map("normalized_name")
  platform       String?
  targetPrice    Int      @map("target_price")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([normalizedName])
  @@map("price_alerts")
}

model ProductCache {
  id             String   @id @default(uuid()) @map("cache_id")
  platform       String
  productId      String?  @map("product_id")
  normalizedName String   @map("normalized_name")
  data           Json
  scrapedAt      DateTime @default(now()) @map("scraped_at")
  expiresAt      DateTime @map("expires_at")

  @@index([platform, scrapedAt])
  @@index([normalizedName, platform])
  @@map("product_cache")
}

model UserSession {
  id           String   @id @default(uuid()) @map("session_id")
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  device       String?
  ip           String?
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}
